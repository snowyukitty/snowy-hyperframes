{
  "$schema": "../../../../shared/schemas/pronunciation-map.schema.json",
  "version": 1,
  "strategy": "display-text-and-tts-text-separated",
  "notes": "Pronunciation map for Snowy HyperFrames TTS projects. Maps English technical terms, product names, and acronyms to phonetic spellings for natural-sounding Mandarin/Cantonese narration.",
  "defaultVoice": "zh-TW-HsiaoChenNeural",
  "language": "zh-Hant",
