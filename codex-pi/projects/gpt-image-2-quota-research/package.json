    "publish": "npx --yes hyperframes@0.8.6 publish",
    "lint": "npx --yes hyperframes@0.8.6 lint",
    "audit": "node ../../../shared/tools/hf.mjs audit",
    "fit-audio": "node ../../../shared/tools/hf.mjs fit-audio",
    "vendor": "node ../../../shared/tools/hf.mjs vendor",
    "doctor": "npx --yes hyperframes@0.8.6 doctor",
    "preview": "npx --yes hyperframes@0.8.6 preview"
  }
}
