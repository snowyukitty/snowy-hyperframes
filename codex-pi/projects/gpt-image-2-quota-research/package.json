{
  "name": "snowy-hyperframes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes hyperframes@0.8.6 preview",
    "check": "node ../../../shared/tools/hf.mjs audit && npx --yes hyperframes@0.8.6 check",
    "tts:prepare": "powershell -ExecutionPolicy Bypass -File scripts/prepare-tts.ps1",
    "tts": "npm run tts:prepare && powershell -ExecutionPolicy Bypass -File scripts/generate-tts.ps1",
