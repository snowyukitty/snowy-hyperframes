{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snowy.local/schemas/hyperframes-project.schema.json",
  "title": "Snowy HyperFrames Project Metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "workflow",
    "createdAt",
    "status",
    "format",
    "language",
    "durationSeconds",
    "tools",
    "auth",
    "imageGeneration",
    "paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "workflow": {
      "enum": [
        "codex-pi",
        "codex",
        "pi",
        "claude"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "draft",
        "ready-to-preview",
        "ready-to-render",
        "rendered",
        "archived"
      ]
    },
    "format": {
      "enum": [
        "hyperframes-presentation",
        "hyperframes-video",
        "hyperframes-demo",
        "audio-research"
      ]
    },
    "language": {
      "type": "string"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 1
    },
    "deliverables": {
      "type": "object",
      "description": "Generated per-locale delivery receipts. Root status and duration remain canonical.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "locale",
          "durationSeconds",
          "entry",
          "measuredAudio",
          "timeline",
          "captions",
          "renderOutput",
          "review"
        ],
        "properties": {
          "locale": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 1
          },
          "entry": {
            "type": "string"
          },
          "measuredAudio": {
            "type": "string"
          },
          "timeline": {
            "type": "string"
          },
          "captions": {
            "type": "object"
          },
          "subtitleTracks": {
            "type": "object",
            "required": [
              "sourceLocale",
              "defaultLocale",
              "cueCount",
              "tracks"
            ],
            "properties": {
              "sourceLocale": {
                "type": "string"
              },
              "defaultLocale": {
                "type": "string"
              },
              "cueCount": {
                "type": "integer",
                "minimum": 1
              },
              "tracks": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "locale",
                    "label",
                    "default",
                    "maxChars",
                    "cueCount",
                    "srt",
                    "vtt",
                    "sha256",
                    "review"
                  ],
                  "properties": {
                    "locale": { "type": "string" },
                    "label": { "type": "string" },
                    "default": { "type": "boolean" },
                    "maxChars": { "type": "integer", "minimum": 8 },
                    "cueCount": { "type": "integer", "minimum": 1 },
                    "srt": { "type": "string" },
                    "vtt": { "type": "string" },
                    "sha256": {
                      "type": "object",
                      "required": ["srt", "vtt"],
                      "properties": {
                        "srt": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                        "vtt": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                      },
                      "additionalProperties": false
                    },
                    "review": {
                      "type": "object",
                      "required": ["status"],
                      "properties": {
                        "status": { "enum": ["pending", "passed", "failed"] }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "renderOutput": {
            "type": "string"
          },
          "review": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "required",
        "notes"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "imageGeneration": {
      "type": "object",
      "required": [
        "mode",
        "provider",
        "notes"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sourceConfidence": {
      "enum": [
        "official-only",
        "mixed",
        "estimate-heavy",
        "unknown",
        "not-applicable"
      ]
    },
    "paths": {
      "type": "object",
      "required": [
        "entry",
        "research",
        "storyboard",
        "references",
        "renderOutput"
      ],
      "properties": {
        "entry": {
          "type": "string"
        },
        "research": {
          "type": "string"
        },
        "storyboard": {
          "type": "string"
        },
        "references": {
          "type": "string"
        },
        "renderOutput": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
