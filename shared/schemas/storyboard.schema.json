{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snowy.local/schemas/storyboard.schema.json",
  "title": "Storyboard Data",
  "type": "object",
  "required": [
    "title",
    "targetDurationSeconds",
    "language",
    "voice",
    "slides"
  ],
  "properties": {
    "title": {
      "type": [
        "string",
        "object"
      ]
    },
    "targetDurationSeconds": {
      "type": "number"
    },
    "language": {
      "type": "string"
    },
    "voice": {
      "type": "object"
    },
    "locales": {
      "type": "object",
      "description": "Deliverable locales. The top-level language is canonical; each locale may override voice settings and pronunciationMap.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "default": {
            "type": "boolean"
          },
          "voice": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "subtitleTracks": {
      "type": "object",
      "description": "Subtitle-only translations of the canonical spoken master. Tracks share one canonical word-boundary timeline and never create audio or render variants.",
      "required": [
        "sourceLocale",
        "default",
        "tracks"
      ],
      "properties": {
        "sourceLocale": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "default": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "tracks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "label",
              "maxChars"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "maxChars": {
                "type": "integer",
                "minimum": 8
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "durationTarget",
          "image",
          "subtitle",
          "narration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "object"
            ]
          },
          "chapter": {
            "type": [
              "string",
              "object"
            ]
          },
          "durationTarget": {
            "type": "number",
            "minimum": 1
          },
          "image": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "object"
            ]
          },
          "narration": {
            "type": [
              "string",
              "object"
            ]
          },
          "ttsText": {
            "type": [
              "string",
              "object"
            ]
          },
          "captionCues": {
            "type": "array",
            "description": "Stable semantic cue ids with exact source transcript partitions and subtitle-only translations.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "text": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "lead",
                    "metrics",
                    "cards",
                    "list",
                    "quote",
                    "source",
                    "chart"
                  ]
                },
                "text": {
                  "type": [
                    "string",
                    "object"
                  ]
                },
                "source": {
                  "type": [
                    "string",
                    "object"
                  ]
                },
                "ordered": {
                  "type": "boolean"
                },
                "items": {
                  "type": "array"
                },
                "chart": {
                  "enum": [
                    "bar",
                    "split",
                    "line"
                  ]
                },
                "series": {
                  "type": "array"
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "object"
                    ]
                  }
                },
                "unit": {
                  "type": [
                    "string",
                    "object"
                  ]
                },
                "max": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                }
              },
              "additionalProperties": true
            }
          },
          "motion": {
            "enum": [
              "rise",
              "hold",
              "focus",
              "reveal"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "description": "Storyboard is the single source of intent. Localizable fields may be canonical strings or explicit locale maps; spoken variants own independent audio and timing. subtitleTracks are different: they translate one canonical spoken master and share its generated cue timeline."
}
