{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snowy.local/schemas/storyboard.schema.json",
  "title": "Storyboard Data",
  "type": "object",
  "required": [
    "title",
    "targetDurationSeconds",
    "language",
    "voice",
    "slides"
  ],
  "properties": {
    "title": {
      "type": [
        "string",
        "object"
      ]
    },
    "targetDurationSeconds": {
      "type": "number"
    },
    "language": {
      "type": "string"
    },
    "voice": {
      "type": "object"
    },
    "locales": {
      "type": "object",
      "description": "Deliverable locales. The top-level language is canonical; each locale may override voice settings and pronunciationMap.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "default": {
            "type": "boolean"
          },
          "voice": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "durationTarget",
          "image",
          "subtitle",
          "narration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "object"
            ]
          },
          "chapter": {
            "type": [
              "string",
              "object"
            ]
          },
          "durationTarget": {
            "type": "number",
            "minimum": 1
          },
          "image": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "string",
              "object"
            ]
          },
          "narration": {
            "type": [
              "string",
              "object"
            ]
          },
          "ttsText": {
            "type": [
              "string",
              "object"
            ]
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "lead",
                    "metrics",
                    "cards",
                    "list",
                    "quote",
                    "source",
                    "chart"
                  ]
                },
                "text": {
                  "type": [
                    "string",
                    "object"
                  ]
                },
                "source": {
                  "type": [
                    "string",
                    "object"
                  ]
                },
                "ordered": {
                  "type": "boolean"
                },
                "items": {
                  "type": "array"
                },
                "chart": {
                  "enum": [
                    "bar",
                    "split",
                    "line"
                  ]
                },
                "series": {
                  "type": "array"
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "object"
                    ]
                  }
                },
                "unit": {
                  "type": [
                    "string",
                    "object"
                  ]
                },
                "max": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                }
              },
              "additionalProperties": true
            }
          },
          "motion": {
            "enum": [
              "rise",
              "hold",
              "focus",
              "reveal"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "description": "Storyboard is the single source of intent. Localizable fields may be canonical strings or explicit locale maps; spoken variant narration and subtitles never fall back silently. Measured timing results live in data/timeline.json for canonical output and data/timeline.<locale>.json for variants."
}
