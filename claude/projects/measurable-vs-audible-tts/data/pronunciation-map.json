{
  "$schema": "../../../../shared/schemas/pronunciation-map.schema.json",
  "version": 1,
  "strategy": "display-text-and-tts-text-separated",
  "notes": "字幕保留官方英文名稱與符號；Edge-TTS 收到的是中文讀得順的版本。",
  "defaultVoice": "zh-TW-HsiaoChenNeural",
  "candidateVoices": ["zh-TW-HsiaoChenNeural", "zh-TW-HsiaoYuNeural", "zh-TW-YunJheNeural"],
  "entries": [
    { "match": "Edge-TTS", "tts": "Edge T T S", "reason": "拆開縮寫比較清楚。" },
    { "match": "F5-TTS", "tts": "F 5 T T S", "reason": "模型名稱逐字讀。" },
    { "match": "TTS", "tts": "T T S", "reason": "拆開縮寫。" },
    { "match": "API key", "tts": "A P I 金鑰", "reason": "自然中文說法。" },
    { "match": "API", "tts": "A P I", "reason": "拆開縮寫。" },
    { "match": "Kokoro-82M", "tts": "Kokoro 八十二 M", "reason": "參數量用中文讀。" },
    { "match": "Kokoro", "tts": "Kokoro", "reason": "保留原名，neural voice 可處理。" },
    { "match": "LUFS", "tts": "L U F S", "reason": "拆開縮寫。" },
    { "match": "RTF", "tts": "R T F", "reason": "拆開縮寫。" },
    { "match": "MB", "tts": "M B", "reason": "拆開單位。" },
    { "match": "CC-BY-NC", "tts": "C C B Y N C", "reason": "授權縮寫逐字讀。" },
    { "match": "MIT", "tts": "M I T", "reason": "授權縮寫逐字讀。" },
    { "match": "Apache 2.0", "tts": "Apache 二點零", "reason": "版本號用中文讀。" },
    { "match": "zh-TW-HsiaoChenNeural", "tts": "曉臻", "reason": "聲音代號在旁白裡改用中文名。" },
    { "match": "zf_xiaobei", "tts": "小北", "reason": "聲音代號在旁白裡改用中文名。" },
    { "match": "markdown", "tts": "mark down", "reason": "分開比較清楚。" },
    { "match": "ffprobe", "tts": "F F probe", "reason": "工具名稱。" },
    { "match": "ffmpeg", "tts": "F F mpeg", "reason": "工具名稱。" },
    { "match": "silencedetect", "tts": "silence detect", "reason": "分開比較清楚。" },
    { "match": "ebur128", "tts": "E B U R 128", "reason": "標準代號逐字讀。" },
    { "match": "repo", "tts": "repo", "reason": "保留。" },
    { "match": "Tier 0", "tts": "Tier 零", "reason": "序號用中文讀。" },
    { "match": "−", "tts": "負", "reason": "負號要念出來。" },
    { "match": "⋯⋯", "tts": "", "reason": "省略號不朗讀。" }
  ]
}
